youdle_env/.history

# Blogger theme artifacts
#
# theme-youdle-homepage.xml is deliberately tracked: a test asserts the
# committed artifact matches its sources, so a stale upload file is caught.
# theme-2263602681587126671.xml is the base the build splices into and is
# tracked too; without it nobody can build the theme at all.

# Generated by blogger/homepage/make_bisect.py while hunting a restore failure.
theme-test-*.xml

# Regenerated on demand from the base plus repair_widget_settings().
theme-base-restorable.xml

# Local backups pulled from Blogger's Theme > Backup. Useful to keep on disk,
# not in history; the test that reads one skips when it is absent.
theme-*saved*.xml
theme-*backup*.xml

# The handoff package. The authoritative copy is
# youdle-next-expo/Youdle_Homepage_Developer_Toolkit/.
Youdle_Homepage_Developer_Package/
