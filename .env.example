# Backend environment variables (never commit real values)
OPENAI_API_KEY=your-openai-key
# Optional; defaults to gpt-4o when omitted, so leave this unset unless you
# mean to override it. Must be a large-context model: a full generation prompt
# is ~14k tokens, so gpt-4 (8k) and gpt-3.5-turbo (16k) cannot hold one. An
# unusable value here is ignored with a warning and the default is used.
# OPENAI_MODEL=gpt-4o
EXA_API_KEY=your-exa-key
GEMINI_API_KEY=your-gemini-key

SUPABASE_URL=https://your-project.supabase.co
# Preferred for the backend and GitHub Actions; never expose this in NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Compatibility fallback used by existing deployments.
SUPABASE_KEY=your-existing-server-key

# Separate Supabase project holding shopper search activity. Read only by the
# weekly and monthly shopper behaviour reports, not by the blog pipeline.
SEARCH_SUPABASE_URL=https://your-search-project.supabase.co
SEARCH_SUPABASE_KEY=your-search-project-key

IMGBB_API_KEY=your-imgbb-key
MAILCHIMP_API_KEY=your-mailchimp-key
MAILCHIMP_LIST_ID=your-mailchimp-list-id
MAILCHIMP_SERVER_PREFIX=your-mailchimp-server-prefix
# Notification email over Google Workspace SMTP.
# SMTP_PASSWORD is a 16-character Google app password, not the account password.
SMTP_USERNAME=info@getyoudle.com
SMTP_PASSWORD=your-app-password
# Who receives the notifications, comma-separated. Required by all five email
# workflows; sends fail without it.
ADMIN_NOTIFICATION_EMAIL=someone@getyoudle.com,someone-else@getyoudle.com
# Optional overrides (defaults shown)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SENDER_EMAIL: leave unset. The From address then follows SMTP_USERNAME, so
# there is one place to change the account. Setting it to anything the account
# is not a verified alias for makes Google refuse the send.

GITHUB_TOKEN=your-company-controlled-token
GITHUB_OWNER=Youdle-Inc
GITHUB_REPO=youdle
